<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>QuickBasic</RootNamespace>
    <AssemblyName>QuickBasic</AssemblyName>
    <MyType>Empty</MyType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <DocumentationFile>QuickBasic.xml</DocumentationFile>
    <NoWarn>$(NoWarn);CA1416;42016;41999;42017;42018;42019;42032;42036;42020;42021;42022</NoWarn>
  </PropertyGroup>

  <!-- the library is OS neutral: no Windows Forms application model or generated settings -->
  <ItemGroup>
    <Compile Remove="My Project\Application.Designer.vb" />
    <Compile Remove="My Project\Settings.Designer.vb" />
    <None Remove="My Project\Settings.settings" />
    <None Remove="My Project\Application.myapp" />
  </ItemGroup>

</Project>
