<Project Sdk="Microsoft.NET.Sdk">

  <!-- GORILLA.BAS (the original, beside this file) converted to Visual Basic for QB.Compatibility; it draws, so it needs the Sdl package. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>Program</StartupObject>
    <RootNamespace></RootNamespace>
    <AssemblyName>Gorilla</AssemblyName>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QB.Compatibility" Version="0.1.1" />
    <PackageReference Include="QB.Compatibility.Sdl" Version="0.1.1" />
  </ItemGroup>

</Project>
