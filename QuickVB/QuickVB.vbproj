<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>QuickVB.App</StartupObject>
    <RootNamespace>QuickVB</RootNamespace>
    <AssemblyName>QuickVB</AssemblyName>
    <MyType>Empty</MyType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.1</Version>
    <Authors>Cory Smith</Authors>
    <Product>QuickVB</Product>
    <Description>A QuickBASIC-style editor, compiler and debugger for Visual Basic, for the terminal.</Description>
    <Copyright>Copyright (c) Cory Smith. Portions Copyright (c) Microsoft Corporation (Apache License 2.0).</Copyright>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DocumentationFile>QuickVB.xml</DocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);41999;42016;42017;42018;42019;42020;42021;42022;42032;42036</WarningsAsErrors>
  </PropertyGroup>

  <!-- no "My" application model: it needs Windows Forms packages, and the program does not use it -->
  <ItemGroup>
    <Compile Remove="My Project\Application.Designer.vb" />
    <Compile Remove="My Project\Settings.Designer.vb" />
    <None Remove="My Project\Settings.settings" />
    <None Remove="My Project\Application.myapp" />
  </ItemGroup>

  <!--
    Everything a program may need travels inside QuickVB itself, so a single file (or one dotnet tool package) is all there is:
    QB.Compatibility (the QuickBASIC statements; a program gets it when it imports a QB namespace), QB.Compatibility.Sdl with SDL2-CS and
    the native SDL2 library of every platform (graphics), QuickVB.Runtime (the part of the debugger that runs inside the program) and the
    sample programs (File > Samples). The packages are only a source for the files; nothing of them is referenced.
  -->
  <PropertyGroup>
    <QbVersion>0.1.1</QbVersion>
    <SdlCsVersion>1.0.82</SdlCsVersion>
  </PropertyGroup>

  <Target Name="EmbedLibraries" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <PropertyGroup>
      <_QbLib>$(NuGetPackageRoot)qb.compatibility/$(QbVersion)/lib/net10.0/</_QbLib>
      <_QbSdlLib>$(NuGetPackageRoot)qb.compatibility.sdl/$(QbVersion)/lib/net10.0/</_QbSdlLib>
      <_SdlCsRoot>$(NuGetPackageRoot)ppy.sdl2-cs/$(SdlCsVersion)/</_SdlCsRoot>
    </PropertyGroup>
    <ItemGroup>
      <EmbeddedResource Include="$(_QbLib)QB.Compatibility.dll" LogicalName="QB.Compatibility.dll" />
      <EmbeddedResource Include="$(_QbSdlLib)QB.Compatibility.Sdl.dll" LogicalName="QB.Compatibility.Sdl.dll" />
      <EmbeddedResource Include="$(_SdlCsRoot)lib/netstandard2.0/SDL2-CS.dll" LogicalName="SDL2-CS.dll" />
      <EmbeddedResource Include="$(_SdlCsRoot)runtimes/win-x64/native/SDL2.dll" LogicalName="native/win-x64/SDL2.dll" />
      <EmbeddedResource Include="$(_SdlCsRoot)runtimes/linux-x64/native/libSDL2.so" LogicalName="native/linux-x64/libSDL2.so" />
      <EmbeddedResource Include="$(_SdlCsRoot)runtimes/osx-x64/native/libSDL2.dylib" LogicalName="native/osx-x64/libSDL2.dylib" />
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'QuickVB.Runtime.dll'" LogicalName="QuickVB.Runtime.dll" />
    </ItemGroup>
  </Target>

  <!-- the sample programs are the ones in their own folders, so there is one copy of each -->
  <ItemGroup>
    <EmbeddedResource Include="..\Nibbles\NIBBLES.vb" LogicalName="samples/NIBBLES.vb" />
    <EmbeddedResource Include="..\Gorilla\GORILLA.vb" LogicalName="samples/GORILLA.vb" />
  </ItemGroup>

  <!-- dotnet publish -r <rid> -p:PublishSingleFile=true (see build/publish.ps1): one file, nothing else to copy -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DocumentationFile></DocumentationFile>
  </PropertyGroup>

  <!--
    dotnet pack: "dotnet tool install -g quickvb" gives a "quickvb" command.
    The licence is the LICENSE file: MIT, with the Apache License 2.0 notice of the original Microsoft sample (a file, since one SPDX expression can't say both).
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>quickvb</ToolCommandName>
    <PackageId>quickvb</PackageId>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/DualBrain/QuickVB</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DualBrain/QuickVB</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <DebugType>embedded</DebugType>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageTags>basic;visualbasic;quickbasic;qbasic;terminal;tui;editor;roslyn</PackageTags>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickVB.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.9.0" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.12" />
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
    <!-- only a source of files to embed (see EmbedLibraries): nothing is referenced or copied -->
    <PackageReference Include="QB.Compatibility" Version="$(QbVersion)" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="QB.Compatibility.Sdl" Version="$(QbVersion)" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="ppy.SDL2-CS" Version="$(SdlCsVersion)" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConsoleGUI\ConsoleGUI.vbproj" />
    <ProjectReference Include="..\QuickVB.Runtime\QuickVB.Runtime.vbproj" />
  </ItemGroup>

</Project>
