<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>QuickVB.App</StartupObject>
    <RootNamespace>QuickVB</RootNamespace>
    <AssemblyName>QuickVB</AssemblyName>
    <MyType>Empty</MyType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Authors>Cory Smith</Authors>
    <Product>QuickVB</Product>
    <Description>A QuickBASIC-style editor, compiler and debugger for Visual Basic, for the terminal.</Description>
    <Copyright>Copyright (c) Cory Smith. Portions Copyright (c) Microsoft Corporation (Apache License 2.0).</Copyright>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DocumentationFile>QuickVB.xml</DocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);41999;42016;42017;42018;42019;42020;42021;42022;42032;42036</WarningsAsErrors>
  </PropertyGroup>

  <!-- no "My" application model: it needs Windows Forms packages, and the program does not use it -->
  <ItemGroup>
    <Compile Remove="My Project\Application.Designer.vb" />
    <Compile Remove="My Project\Settings.Designer.vb" />
    <None Remove="My Project\Settings.settings" />
    <None Remove="My Project\Application.myapp" />
  </ItemGroup>

  <!--
    The libraries a program may use travel inside QuickVB itself, so a single-file QuickVB has everything to take them from: QB.Compatibility
    (the QuickBASIC statements; a program gets it when it imports a QB namespace), QB.Compatibility.Sdl with SDL2 (graphics), and QuickVB.Runtime
    (the part of the debugger that runs inside the program). The packages are only a source for the files; nothing of them is referenced.
    SDL2's native library is embedded for the platform being built for (publish with -r <rid>; otherwise this machine's).
  -->
  <PropertyGroup>
    <QbVersion>0.1.0-preview.1</QbVersion>
    <SdlCsVersion>1.0.82</SdlCsVersion>
    <_SdlRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_SdlRid>
    <_SdlRid Condition="'$(_SdlRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</_SdlRid>
    <_SdlRid Condition="'$(_SdlRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-x64</_SdlRid>
    <_SdlRid Condition="'$(_SdlRid)' == ''">linux-x64</_SdlRid>
    <_SdlNative Condition="$(_SdlRid.StartsWith('win'))">SDL2.dll</_SdlNative>
    <_SdlNative Condition="$(_SdlRid.StartsWith('osx'))">libSDL2.dylib</_SdlNative>
    <_SdlNative Condition="$(_SdlRid.StartsWith('linux'))">libSDL2.so</_SdlNative>
  </PropertyGroup>

  <Target Name="EmbedLibraries" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <PropertyGroup>
      <_QbLib>$(NuGetPackageRoot)qb.compatibility/$(QbVersion)/lib/net10.0/</_QbLib>
      <_QbSdlLib>$(NuGetPackageRoot)qb.compatibility.sdl/$(QbVersion)/lib/net10.0/</_QbSdlLib>
      <_SdlCsRoot>$(NuGetPackageRoot)ppy.sdl2-cs/$(SdlCsVersion)/</_SdlCsRoot>
    </PropertyGroup>
    <ItemGroup>
      <EmbeddedResource Include="$(_QbLib)QB.Compatibility.dll" LogicalName="QB.Compatibility.dll" />
      <EmbeddedResource Include="$(_QbSdlLib)QB.Compatibility.Sdl.dll" LogicalName="QB.Compatibility.Sdl.dll" />
      <EmbeddedResource Include="$(_SdlCsRoot)lib/netstandard2.0/SDL2-CS.dll" LogicalName="SDL2-CS.dll" />
      <EmbeddedResource Include="$(_SdlCsRoot)runtimes/$(_SdlRid)/native/$(_SdlNative)" LogicalName="native/$(_SdlNative)" Condition="Exists('$(_SdlCsRoot)runtimes/$(_SdlRid)/native/$(_SdlNative)')" />
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'QuickVB.Runtime.dll'" LogicalName="QuickVB.Runtime.dll" />
    </ItemGroup>
  </Target>

  <!-- dotnet publish -r <rid> -p:PublishSingleFile=true (see build/publish.ps1): one file, nothing else to copy -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DocumentationFile></DocumentationFile>
  </PropertyGroup>

  <!--
    dotnet pack: "dotnet tool install -g QuickVB" gives a "quickvb" command. The names below are working defaults, not decisions.
    No licence is declared yet (PackageLicenseExpression) until that is settled.
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>quickvb</ToolCommandName>
    <PackageId>QuickVB</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>basic;visualbasic;quickbasic;qbasic;terminal;tui;editor;roslyn</PackageTags>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickVB.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.9.0" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.12" />
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
    <!-- only a source of files to embed (see EmbedLibraries): nothing is referenced or copied -->
    <PackageReference Include="QB.Compatibility" Version="$(QbVersion)" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="QB.Compatibility.Sdl" Version="$(QbVersion)" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="ppy.SDL2-CS" Version="$(SdlCsVersion)" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConsoleGUI\ConsoleGUI.vbproj" />
    <ProjectReference Include="..\QuickVB.Runtime\QuickVB.Runtime.vbproj" />
  </ItemGroup>

</Project>
