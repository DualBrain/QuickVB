<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>QuickVB.App</StartupObject>
    <RootNamespace>QuickVB</RootNamespace>
    <AssemblyName>QuickVB</AssemblyName>
    <MyType>Empty</MyType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Authors>Cory Smith</Authors>
    <Product>QuickVB</Product>
    <Description>A QuickBASIC-style editor, compiler and debugger for Visual Basic, for the terminal.</Description>
    <Copyright>Copyright (c) Cory Smith. Portions Copyright (c) Microsoft Corporation (Apache License 2.0).</Copyright>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DocumentationFile>QuickVB.xml</DocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);41999;42016;42017;42018;42019;42020;42021;42022;42032;42036</WarningsAsErrors>
  </PropertyGroup>

  <!-- no "My" application model: it needs Windows Forms packages, and the program does not use it -->
  <ItemGroup>
    <Compile Remove="My Project\Application.Designer.vb" />
    <Compile Remove="My Project\Settings.Designer.vb" />
    <None Remove="My Project\Settings.settings" />
    <None Remove="My Project\Application.myapp" />
  </ItemGroup>

  <!--
    QuickBasic.dll travels inside QuickVB itself: programs written in QuickVB are compiled against it and need a copy next to them, and a
    single-file QuickVB has no file to take it from.
  -->
  <Target Name="EmbedQuickBasic" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'QuickBasic.dll'" LogicalName="QuickBasic.dll" />
    </ItemGroup>
  </Target>

  <!-- dotnet publish -r <rid> -p:PublishSingleFile=true (see build/publish.ps1): one file, nothing else to copy -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DocumentationFile></DocumentationFile>
  </PropertyGroup>

  <!--
    dotnet pack: "dotnet tool install -g QuickVB" gives a "quickvb" command. The names below are working defaults, not decisions.
    No licence is declared yet (PackageLicenseExpression) until that is settled.
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>quickvb</ToolCommandName>
    <PackageId>QuickVB</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>basic;visualbasic;quickbasic;qbasic;terminal;tui;editor;roslyn</PackageTags>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickVB.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.9.0" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.12" />
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConsoleGUI\ConsoleGUI.vbproj" />
    <ProjectReference Include="..\QuickBasic\QuickBasic.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TestProject\**" />
  </ItemGroup>

</Project>
