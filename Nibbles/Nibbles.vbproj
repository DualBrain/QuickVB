<Project Sdk="Microsoft.NET.Sdk">

  <!-- NIBBLES.BAS (the original, beside this file) converted to Visual Basic for QB.Compatibility; it only uses the text screen. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>Program</StartupObject>
    <RootNamespace></RootNamespace>
    <AssemblyName>Nibbles</AssemblyName>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QB.Compatibility" Version="0.1.3" />
  </ItemGroup>

</Project>
