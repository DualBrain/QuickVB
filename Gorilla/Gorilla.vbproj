<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>Main</StartupObject>
    <RootNamespace></RootNamespace>
    <AssemblyName>Gorilla</AssemblyName>
    <MyType>Empty</MyType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OptionExplicit>Off</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>Off</OptionInfer>
    <DocumentationFile>Gorilla.xml</DocumentationFile>
    <NoWarn>$(NoWarn);CA1416;42016;41999;42017;42018;42019;42032;42036;42020;42021;42022</NoWarn>
  </PropertyGroup>

  <!-- no "My" application model: it needs Windows Forms packages, and the program does not use it -->
  <ItemGroup>
    <Compile Remove="My Project\Application.Designer.vb" />
    <Compile Remove="My Project\Settings.Designer.vb" />
    <None Remove="My Project\Settings.settings" />
    <None Remove="My Project\Application.myapp" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="QuickBasic" />
    <Import Include="QuickBasic.Compatibility" />
    <Import Include="QuickBasic.Constants" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickBasic\QuickBasic.vbproj" />
  </ItemGroup>

</Project>
